<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Microsoft.NET.Sdk plus this framework reference, not Microsoft.NET.Sdk.Web: a plugin is a
         headless process rather than a web application, and docs/plugin-development/plugin-hosting.md
         recommends the console form for exactly that reason. The framework reference is what supplies
         WebApplicationBuilder and the rest of the hosting surface MacroDeck.Plugin.Hosting builds on. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Build-time only: compile-time diagnostics for plugin authors, and the [MacroDeckSdkUsage]
             attribute the host reads to report real deprecation usage. Never shipped in the output.
             The package's own build/*.props is what feeds manifest.json to MDP1001 as an AdditionalFile. -->
        <PackageReference Include="MacroDeck.Plugin.Analyzers" PrivateAssets="all" />
        <PackageReference Include="MacroDeck.Plugin.Hosting" />
        <PackageReference Include="MacroDeck.Plugin.Serilog" />
        <PackageReference Include="MacroDeck.Sdk" />
    </ItemGroup>

    <!-- manifest.json and Assets\icon.svg both need to land next to the built executable: the SDK reads
         the manifest from the content root at startup and resolves the icon path against that same root,
         serving its bytes from disk over the asset pipeline. -->
    <ItemGroup>
        <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\icon.svg" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
